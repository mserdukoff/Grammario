rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sentences collection rules - EXISTING (KEEP AS IS)
    match /sentences/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Quizzes collection rules - EXISTING (KEEP AS IS)
    match /quizzes/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Test collection (for debugging) - EXISTING (KEEP AS IS)
    match /test/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // NEW COLLECTIONS FOR PROGRESS TRACKING FEATURES:
    
    // User progress collection - stores overall user progress and achievements
    match /user_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Study sessions collection - tracks user study sessions
    match /study_sessions/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Achievement unlocks collection - records when users unlock achievements
    match /achievement_unlocks/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}

